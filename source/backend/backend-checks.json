  {
    "id": "sql-q11",
    "questionId": "backend-01-q11",
    "revision": 1,
    "kind": "sql",
    "setup": [
      "DROP TABLE IF EXISTS staff",
      "CREATE TABLE staff(id INT PRIMARY KEY, dept VARCHAR(20), bonus INT)",
      "INSERT INTO staff VALUES (1,'개발',100),(2,'개발',NULL),(3,'개발',200),(4,'운영',300),(5,'운영',NULL),(6,'디자인',NULL)"
    ],
    "steps": [
      {
        "sql": "SELECT dept, COUNT(*), COUNT(bonus), AVG(bonus) FROM staff GROUP BY dept HAVING COUNT(*) >= 2 ORDER BY dept",
        "expect": {
          "rows": [
            [
              "개발",
              "3",
              "2",
              "150.0000"
            ],
            [
              "운영",
              "2",
              "1",
              "300.0000"
            ]
          ],
          "ordered": true
        }
      },
      {
        "sql": "SELECT dept, COUNT(*), COUNT(bonus), AVG(bonus) FROM staff GROUP BY dept ORDER BY dept",
        "expect": {
          "rows": [
            [
              "개발",
              "3",
              "2",
              "150.0000"
            ],
            [
              "디자인",
              "1",
              "0",
              "NULL"
            ],
            [
              "운영",
              "2",
              "1",
              "300.0000"
            ]
          ],
          "ordered": true
        }
      },
      {
        "sql": "SELECT dept, AVG(IFNULL(bonus,0)) FROM staff GROUP BY dept HAVING COUNT(*) >= 2 ORDER BY dept",
        "expect": {
          "rows": [
