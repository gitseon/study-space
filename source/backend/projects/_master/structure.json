        "    Member login(String email, String password);",
        "    List<Gear> selectAll();",
        "    int insert(Gear gear);",
        "    Gear detail(String code);",
        "}",
        "",
        "public class GearServiceImpl implements GearService {",
        "    private final GearDao dao = GearDaoImpl.getInstance();",
