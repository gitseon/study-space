    "nodes": [
      {
        "id": "browser",
        "layer": "client",
        "label": "브라우저",
        "kind": "요청",
        "path": null,
        "role": "사용자가 링크를 누르거나 form을 제출하면 URL과 action, 입력 값을 서버로 보냅니다. 응답이 redirect이면 주소를 다시 요청합니다.",
        "receives": [
          "forward한 JSP가 만든 HTML",
          "redirect 응답의 새 주소"
        ],
        "sends": [
          "URL (/book, /user)",
          "action 파라미터",
          "form 입력의 name=value",
          "쿠키 JSESSIONID, email"
        ],
        "methods": [],
        "targets": [],
        "skeleton": [
          "GET  /book?action=list",
          "GET  /book?action=detail&code=...",
          "POST /book   (action=regist, code, name, price, author, category)",
          "POST /book   (action=delete, code)",
          "POST /user   (action=login, email, pass, remember-me)",
          "GET  /user?action=logout"
        ]
      },
      {
        "id": "index",
        "layer": "view",
        "label": "index.jsp",
        "kind": "JSP",
        "path": "src/main/webapp/index.jsp",
        "role": "메인 화면입니다. header.jsp를 include해 메뉴를 보여줍니다. 제공 파일입니다.",
        "receives": [
          "세션 속성 user (header.jsp에서 사용)"
        ],
        "sends": [],
        "methods": [],
        "targets": [],
        "skeleton": [
          "<%@ include file=\"/header.jsp\"%>",
          "<h1>메인 페이지입니다.</h1>"
        ]
      },
      {
        "id": "header",
        "layer": "view",
        "label": "header.jsp",
        "kind": "JSP",
        "path": "src/main/webapp/header.jsp",
        "role": "모든 화면이 include하는 머리글입니다. 로그인 여부에 따라 로그인 링크 또는 사용자 이름과 로그아웃 링크를 보여주고 alertMsg가 있으면 안내를 출력합니다.",
        "receives": [
          "세션 속성 user",
          "request 속성 alertMsg"
        ],
        "sends": [
          "링크: /book?action=list, /user?action=login, /user?action=logout"
        ],
        "methods": [],
        "targets": [
          "jsp-header"
        ],
        "skeleton": [
          "<%@ taglib prefix=\"c\" uri=\"jakarta.tags.core\"%>",
          "<c:set var=\"root\" value=\"${pageContext.servletContext.contextPath}\" />",
          "<nav> ... 홈, 목록 링크 ...",
          "    <%-- 작성 대상: 로그인 상태에 따라 달라지는 메뉴 --%>",
          "</nav>",
          "<%-- alertMsg 출력 --%>"
        ]
      },
      {
        "id": "list",
        "layer": "view",
        "label": "book/list.jsp",
        "kind": "JSP",
        "path": "src/main/webapp/book/list.jsp",
        "role": "도서 목록 표를 보여줍니다. 비어 있으면 안내 행을 보여주고 코드는 상세 화면으로 가는 링크입니다.",
        "receives": [
          "request 속성 list (List<Book>)"
        ],
        "sends": [
          "링크: /book?action=detail&code=...",
          "링크: /book?action=regist"
        ],
        "methods": [],
        "targets": [
          "jsp-list"
        ],
        "skeleton": [
          "<%@ taglib prefix=\"c\" uri=\"jakarta.tags.core\"%>",
          "<%@ include file=\"/header.jsp\"%>",
          "<table> <thead> ... </thead>",
          "  <tbody>",
          "    <%-- 작성 대상: 목록 본문 행 --%>",
          "  </tbody>",
          "</table>"
        ]
      },
      {
        "id": "regist",
        "layer": "view",
        "label": "book/regist.jsp",
        "kind": "JSP",
        "path": "src/main/webapp/book/regist.jsp",
        "role": "도서 등록 form입니다. input의 name이 컨트롤러가 읽는 파라미터 이름이 됩니다.",
        "receives": [
          "request 속성 alertMsg (검증 실패, 코드 중복)"
        ],
        "sends": [
          "POST /book (action=regist, code, name, price, author, category)"
        ],
        "methods": [],
        "targets": [
          "jsp-regist"
        ],
        "skeleton": [
          "<%@ taglib prefix=\"c\" uri=\"jakarta.tags.core\"%>",
          "<%@ include file=\"/header.jsp\"%>",
          "<h1>등록 페이지</h1>",
          "<%-- 작성 대상: 등록 form --%>",
          "<a href=\"${root}/book?action=list\">목록으로</a>"
        ]
      },
      {
        "id": "detail",
        "layer": "view",
        "label": "book/detail.jsp",
        "kind": "JSP",
        "path": "src/main/webapp/book/detail.jsp",
        "role": "도서 한 건과 삭제 버튼을 보여줍니다. 삭제는 링크가 아니라 POST form입니다.",
        "receives": [
          "request 속성 book (Book)"
        ],
        "sends": [
          "POST /book (action=delete, code)"
        ],
        "methods": [],
        "targets": [
          "jsp-detail"
        ],
        "skeleton": [
          "<%@ taglib prefix=\"c\" uri=\"jakarta.tags.core\"%>",
          "<%@ include file=\"/header.jsp\"%>",
          "<h1>상세 페이지</h1>",
          "<%-- 작성 대상: 상세 정보와 삭제 form --%>",
          "<a href=\"${root}/book?action=list\">목록으로</a>"
        ]
      },
      {
        "id": "login",
        "layer": "view",
        "label": "login-form.jsp",
        "kind": "JSP",
        "path": "src/main/webapp/login-form.jsp",
        "role": "로그인 form입니다. 저장된 email 쿠키가 있으면 이메일을 채우고 기억하기를 선택해 둡니다.",
