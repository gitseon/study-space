        ]
      },
      {
        "id": "logging",
        "layer": "filter",
        "label": "LoggingFilter",
        "kind": "Filter",
        "path": "src/main/java/com/ssafy/sample/filter/LoggingFilter.java",
        "role": "/* 모든 요청의 파라미터를 콘솔에 출력합니다. 비밀번호는 가려서 출력합니다. 제공 파일입니다.",
        "receives": [
          "모든 요청"
        ],
        "sends": [
          "chain.doFilter로 다음 단계에 전달"
        ],
        "methods": [
          "doFilter"
        ],
        "targets": [],
        "skeleton": [
          "@WebFilter(\"/*\")",
          "public class LoggingFilter extends HttpFilter {",
          "    public void doFilter(ServletRequest request, ServletResponse response, FilterChain chain) ...",
          "}"
        ]
      },
      {
        "id": "session",
        "layer": "filter",
        "label": "SessionFilter",
        "kind": "Filter",
        "path": "src/main/java/com/ssafy/sample/filter/SessionFilter.java",
        "role": "/book 요청만 보호합니다. 세션 속성 user가 있으면 통과시키고 없으면 로그인 화면으로 redirect합니다. /user는 대상이 아니라 로그인 요청이 막히지 않습니다.",
        "receives": [
          "/book 요청"
        ],
        "sends": [
          "통과: chain.doFilter",
          "차단: redirect /user?action=login"
        ],
        "methods": [
          "doFilter"
        ],
        "targets": [
