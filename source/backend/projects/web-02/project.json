        ]
      },
      {
        "id": "error",
        "layer": "view",
        "label": "error/404.jsp, 500.jsp",
        "kind": "JSP",
        "path": "src/main/webapp/error/404.jsp",
        "role": "web.xml의 error-page 매핑으로 열리는 오류 화면입니다. 내부 예외 정보는 보여주지 않습니다. 제공 파일입니다.",
