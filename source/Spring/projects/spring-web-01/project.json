    ],
    "nodes": [
      {
        "id": "browser",
        "layer": "client",
        "label": "브라우저",
        "kind": "요청",
        "path": null,
        "role": "링크를 누르거나 form을 제출해 URL과 입력 값을 서버로 보냅니다. redirect 응답이면 새 주소를 다시 요청합니다.",
        "receives": [
          "JSP가 만든 HTML",
          "redirect 응답의 새 주소"
        ],
        "sends": [
          "GET /reservations",
          "POST /reservations",
          "POST /reservations/{id}/delete"
        ],
        "methods": [],
        "targets": [],
        "skeleton": [
          "GET  /reservations?roomId=...&keyword=...",
          "GET  /reservations/{id}",
          "POST /reservations   (roomId, memberName, people)",
          "POST /reservations/{id}/delete"
        ]
      },
      {
        "id": "controller",
        "layer": "controller",
        "label": "ReservationController",
        "kind": "컨트롤러",
        "path": "src/main/java/com/study/room/web/ReservationController.java",
        "role": "요청을 매핑하고 파라미터를 바인딩해 서비스를 호출합니다. 결과를 모델에 담아 뷰 이름을 반환하고 변경이 끝나면 redirect합니다.",
        "receives": [
          "요청 파라미터와 경로 변수",
          "검증 결과(BindingResult)"
        ],
        "sends": [
          "모델 속성",
          "뷰 이름 또는 redirect 주소"
        ],
        "methods": [
          "list",
          "detail",
          "create",
          "cancel"
        ],
        "targets": [
          "ctrl-list",
          "ctrl-detail",
          "ctrl-create",
          "ctrl-cancel"
        ],
        "skeleton": [
          "// GET /reservations: 조건으로 목록을 찾아 모델에 담는다",
          "// GET /reservations/{id}: 예약 한 건을 모델에 담는다",
          "// POST /reservations: 검증하고 저장한 뒤 redirect한다",
          "// POST /reservations/{id}/delete: 취소하고 redirect한다"
        ]
      },
      {
        "id": "advice",
        "layer": "controller",
        "label": "GlobalExceptionHandler",
        "kind": "예외 처리",
        "path": "src/main/java/com/study/room/web/GlobalExceptionHandler.java",
        "role": "컨트롤러와 서비스에서 던진 예외를 상태 코드와 오류 화면으로 바꿉니다.",
        "receives": [
          "ReservationNotFoundException",
          "RoomFullException"
