        "sends": [
          "404 error/not-found",
          "409 error/full"
        ],
        "methods": [
          "notFound"
        ],
        "targets": [
          "exc-notfound"
        ],
        "skeleton": [
          "// ReservationNotFoundException: 404와 not-found 화면",
