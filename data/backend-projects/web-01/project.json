        "kind": "요청",
        "path": null,
        "role": "사용자가 링크를 누르거나 form을 제출하면 URL과 action, 입력 값을 서버로 보냅니다. 응답이 redirect이면 주소를 다시 요청합니다.",
        "receives": [
          "forward한 JSP가 만든 HTML",
          "redirect 응답의 새 주소"
        ],
        "sends": [
          "URL (/gear)",
          "action 파라미터",
          "form 입력의 name=value",
          "쿠키 JSESSIONID"
        ],
        "methods": [],
        "targets": [],
        "skeleton": [
          "GET  /gear?action=list",
          "GET  /gear?action=detail&code=...",
          "POST /gear   (action=regist, code, name, price, brand, color)",
          "POST /gear   (action=login, email, pass)",
          "GET  /gear?action=logout"
        ]
      },
