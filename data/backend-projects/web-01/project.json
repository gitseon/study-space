        ],
        "sends": [
          "forward: request 속성 list, gear, alertMsg",
          "redirect: /gear?action=list, /",
          "세션 속성 user",
          "sendError: 404"
        ],
        "methods": [
          "doGet",
          "doPost",
          "process",
          "list",
          "regist",
          "detail",
          "login",
          "logout"
        ],
        "targets": [
          "ctrl-dispatch",
          "ctrl-list",
          "ctrl-regist",
          "ctrl-detail",
          "ctrl-login",
          "ctrl-logout"
        ],
        "skeleton": [
          "@WebServlet(\"/gear\")",
          "public class GearController extends HttpServlet implements ControllerHelper {",
          "    private final GearService service = GearServiceImpl.getInstance();",
          "",
          "    protected void doGet(HttpServletRequest request, HttpServletResponse response) ...   // process 호출",
          "    protected void doPost(HttpServletRequest request, HttpServletResponse response) ...  // process 호출",
          "",
          "    private void process(HttpServletRequest request, HttpServletResponse response) ...  // 작성 대상: action 분기",
          "    private void list(HttpServletRequest request, HttpServletResponse response) ...     // 작성 대상",
          "    private void regist(HttpServletRequest request, HttpServletResponse response) ...   // 작성 대상",
          "    private void detail(HttpServletRequest request, HttpServletResponse response) ...   // 작성 대상",
          "    private void login(HttpServletRequest request, HttpServletResponse response) ...    // 작성 대상",
          "    private void logout(HttpServletRequest request, HttpServletResponse response) ...   // 작성 대상",
          "}"
        ]
      },
      {
        "id": "service",
        "layer": "service",
        "label": "GearService / GearServiceImpl",
        "kind": "Service",
        "path": "src/main/java/com/ssafy/sample/model/service/GearServiceImpl.java",
        "role": "컨트롤러와 DAO 사이의 계층입니다. DAO를 호출하고 SQLException을 상위 계층이 다루기 쉬운 예외로 바꿉니다. 중복 키는 저장하지 못한 것이므로 insert가 0을 반환합니다.",
        "receives": [
          "컨트롤러의 호출"
        ],
        "sends": [
